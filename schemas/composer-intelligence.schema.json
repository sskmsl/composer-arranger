{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://composer-arranger.local/schemas/composer-intelligence.schema.json",
  "title": "Composer Intelligence Knowledge Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "techniques", "principles"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "techniques": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/technique"
      }
    },
    "principles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/principle"
      }
    }
  },
  "$defs": {
    "status": {
      "enum": ["draft", "validated", "retired"]
    },
    "generatorTarget": {
      "enum": ["decoration", "phrase", "counter", "melody"]
    },
    "category": {
      "enum": [
        "decoration",
        "phrase",
        "counter",
        "transition",
        "texture",
        "dynamics",
        "harmony",
        "rhythm",
        "sound-design",
        "automation",
        "arrangement",
        "mix-perspective"
      ]
    },
    "weightedValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "weight"],
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1
        },
        "weight": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "generatorTargets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/generatorTarget"
          }
        },
        "sectionRoles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "transitions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+->[a-z0-9-]+$"
          }
        },
        "targetEnergy": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["low", "medium", "high"]
          }
        }
      }
    },
    "preferenceMap": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "$ref": "#/$defs/weightedValue"
        }
      },
      "propertyNames": {
        "enum": [
          "melodicDirection",
          "register",
          "registerDirection",
          "densityDirection",
          "energyDirection",
          "entryOffset",
          "partRole",
          "layerType",
          "intervalCharacter",
          "phraseContour",
          "phraseDensity",
          "rhythmCharacter",
          "harmonicApproach",
          "cadenceType",
          "contourRelation",
          "registerRelation",
          "independenceLevel",
          "motifIdentity",
          "rhythmGrammar",
          "phraseArchitecture",
          "harmonicResponse",
          "registerTrajectory",
          "developmentStrategy",
          "climaxPlacement",
          "decorationGestureRole",
          "decorationShape",
          "decorationRhythmStyle"
        ]
      }
    },
    "technique": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "status",
        "category",
        "observation",
        "intent",
        "generatorTargets",
        "genreSourceIds",
        "priority",
        "confidence",
        "rule"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^technique-[a-z0-9-]+$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "category": {
          "$ref": "#/$defs/category"
        },
        "observation": {
          "type": "string",
          "minLength": 1
        },
        "intent": {
          "type": "string",
          "minLength": 1
        },
        "generatorTargets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/generatorTarget"
          }
        },
        "genreSourceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^genre-source-[a-z0-9-]+$"
          }
        },
        "priority": {
          "const": 50
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rule": {
          "type": "object",
          "additionalProperties": false,
          "required": ["when", "prefer"],
          "properties": {
            "when": {
              "$ref": "#/$defs/condition"
            },
            "prefer": {
              "$ref": "#/$defs/preferenceMap"
            }
          }
        }
      }
    },
    "principle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "status",
        "techniqueId",
        "observationIds",
        "referenceCount",
        "statement",
        "confidence",
        "generatorTargets"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^principle-[a-z0-9-]+$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "techniqueId": {
          "type": "string",
          "pattern": "^technique-[a-z0-9-]+$"
        },
        "observationIds": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^observation-[a-z0-9-]+$"
          }
        },
        "referenceCount": {
          "type": "integer",
          "minimum": 3
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "generatorTargets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/generatorTarget"
          }
        }
      }
    }
  }
}
